<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF は .NET Standard 2.0 に含まれないため net472 -->
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <Authors>Keiji Mitsubuchi</Authors>
    <Description>SVG renderer for WPF</Description>
    <Copyright>Keiji Mitsubuchi</Copyright>
    <Company>Virtual IP Production</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- SVG は仕様が大きいため解析は SharpVectors に任せる -->
    <PackageReference Include="SharpVectors" Version="1.8.4" />
  </ItemGroup>

</Project>
