# 既定は Git に改行の判定を任せる
* text=auto

# ソースは作業ツリーで CRLF（Windows / VS2022 前提）
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.xaml    text eol=crlf
*.config  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# ドキュメントは LF
*.md   text eol=lf
*.svg  text eol=lf
*.json text eol=lf
*.yml  text eol=lf

# バイナリ
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
