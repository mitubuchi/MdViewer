<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF は .NET Standard 2.0 に含まれないため、描画側はここで Windows 専用になる。
         net472 は Unity や既存の .NET Framework アプリ向け、net9.0-windows は
         .NET 5 以降のアプリ（MindMap のパッケージなど）向け。ソースは共通。 -->
    <TargetFrameworks>net472;net9.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <Authors>Keiji Mitsubuchi</Authors>
    <Description>Markdown renderer for WPF</Description>
    <Copyright>Keiji Mitsubuchi</Copyright>
    <Company>Virtual IP Production</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- 解析は MdLib、Markdown 内の .svg 画像は SvgWpf、
         それ以外の画像と動画サムネイルは ImgWpf に任せる -->
    <ProjectReference Include="..\MdLib\MdLib.csproj" />
    <ProjectReference Include="..\SvgWpf\SvgWpf.csproj" />
    <ProjectReference Include="..\ImgWpf\ImgWpf.csproj" />
  </ItemGroup>

</Project>
