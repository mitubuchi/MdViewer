<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF は .NET Standard 2.0 に含まれないため net472 -->
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <Authors>Keiji Mitsubuchi</Authors>
    <Description>Markdown renderer for WPF</Description>
    <Copyright>Keiji Mitsubuchi</Copyright>
    <Company>Virtual IP Production</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- 解析は MdLib、Markdown 内の .svg 画像は SvgWpf、
         それ以外の画像と動画サムネイルは ImgWpf に任せる -->
    <ProjectReference Include="..\MdLib\MdLib.csproj" />
    <ProjectReference Include="..\SvgWpf\SvgWpf.csproj" />
    <ProjectReference Include="..\ImgWpf\ImgWpf.csproj" />
  </ItemGroup>

</Project>
