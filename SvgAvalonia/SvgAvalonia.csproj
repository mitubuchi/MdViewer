<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Authors>Keiji Mitsubuchi</Authors>
    <Description>SVG viewer for Avalonia</Description>
    <Copyright>Keiji Mitsubuchi</Copyright>
    <Company>Virtual IP Production</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- SVG の解析は Svg.Skia に任せる（SvgWpf が SharpVectors に任せるのと同じ考え方） -->
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
  </ItemGroup>

</Project>
